# Supabase project settings -> Project Settings -> API
# Only the public "anon" (or "publishable") key belongs here.
# NEVER put the service_role key in any VITE_ variable - it would be shipped to browsers.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Optional: your production URL (used for canonical / Open Graph URLs), no trailing slash
VITE_SITE_URL=https://your-domain.vercel.app
